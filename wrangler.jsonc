{
  // Cloudflare settings for the Waterline Photography website.
  // "name" must match the Worker's name in the Cloudflare dashboard.
  "name": "waterline-photography",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
